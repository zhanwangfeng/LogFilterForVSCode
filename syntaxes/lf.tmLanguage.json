{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LogFilterPro",
  "scopeName": "source.lf",
  "patterns": [
    { "include": "#comments" },
    { "include": "#commands" },
    { "include": "#params" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.lf",
      "match": "^\\s*#.*$"
    },
    "commands": {
      "name": "keyword.control.lf",
      "match": "^\\s*!\\w+.*$"
    },
    "params": {
      "name": "entity.other.attribute-name.lf",
      "match": "^\\s*-[\\w-]+"
    }
  }
}
