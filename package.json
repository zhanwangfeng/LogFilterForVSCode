{
  "name": "logfilterpro",
  "displayName": "%displayName%",
  "description": "%description%",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhanwangfeng/LogFilterForVSCode.git"
  },
  "version": "0.0.18",
  "publisher": "zhanwangfeng",
  "license": "MIT",
  "icon": "icons/icon-128.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:logFilterPro.openPreview",
    "onCommand:logFilterPro.createLogFilterPro",
    "onCommand:logFilterPro.filterCurrentLine",
    "onLanguage:lf"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "logFilterPro.openPreview",
        "title": "%command.openPreview.title%"
      },
      {
        "command": "logFilterPro.createLogFilterPro",
        "title": "%command.createLogFilterPro.title%"
      },
      {
        "command": "logFilterPro.filterUpToLine",
        "title": "%command.filterUpToLine.title%"
      },
      {
        "command": "logFilterPro.filterCurrentLine",
        "title": "%command.filterCurrentLine.title%"
      },
      {
        "command": "logFilterPro.showLfError",
        "title": "%command.showLfError.title%"
      }
    ],
    "languages": [
      {
        "id": "lf",
        "extensions": [
          ".lf"
        ],
        "aliases": [
          "LogFilterPro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lf",
        "scopeName": "source.lf",
        "path": "./syntaxes/lf.tmLanguage.json"
      }
    ],
    "keybindings": [
      {
        "command": "logFilterPro.filterCurrentLine",
        "key": "ctrl+enter",
        "when": "editorLangId == lf"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "logFilterPro.openPreview",
          "group": "navigation",
          "when": "resourceExtname == .log && logFilterPro:lfFileExists"
        },
        {
          "command": "logFilterPro.createLogFilterPro",
          "group": "navigation",
          "when": "resourceExtname == .log && !logFilterPro:lfFileExists"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node -e \"const v=require('./package.json').version; require('child_process').execSync('vsce package --out ./release/logfilterpro-'+v+'.vsix',{stdio:'inherit',shell:true})\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^2.32.0",
    "cheerio": "^1.0.0-rc.12",
    "typescript": "^5.7.0"
  }
}
